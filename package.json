{
  "name": "youtrack-app-example",
  "version": "2.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode backend && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf archive_name.zip && cd build && zip -r ../archive_name.zip .",
    "upload": "youtrack-workflow upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.23.4",
    "@jetbrains/ring-ui-built": "^7.0.126",
    "@jetbrains/youtrack-scripting": "^0.2.1",
    "@jetbrains/youtrack-scripting-api": "^2022.1.46592",
    "@vitejs/plugin-react": "^6.1.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-drawio": "^1.0.7",
    "react-i18next": "^17.0.15",
    "run": "^1.5.0",
    "tailwindcss": "^4.3.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jquery": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^6.0.3"
  }
